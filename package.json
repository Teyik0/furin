{
  "name": "@teyik0/furin-root",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "bun run --filter '@teyik0/furin' build && bun run --parallel --filter '!@teyik0/furin' build",
    "cache:clean": "rm -rf node_modules examples/*/node_modules packages/*/node_modules && bun pm cache rm",
    "dev": "bun run --parallel --filter '*' --if-present dev",
    "fix": "ultracite fix",
    "iup": "bun update --interactive --recursive",
    "knip": "knip",
    "prepare": "lefthook install",
    "preview:publish": "pkg-pr-new publish --bun --no-compact --packageManager=bun ./packages/core ./packages/electrobun ./apps/scaffolder",
    "start": "bun run --parallel --filter '*' --if-present start",
    "test": "bun run test:release && bun run --parallel --filter '*' test",
    "test:dev": "bun run --parallel --filter '*' test:dev",
    "test:release": "bun test scripts/release-target.test.ts",
    "tscheck": "tsc --noEmit -p scripts/tsconfig.release.json && bun run --parallel --filter '*' tscheck"
  },
  "overrides": {
    "@esbuild-kit/core-utils>esbuild": "0.25.12",
    "postcss-selector-parser": "7.1.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@happy-dom/global-registrator": "^20.14.5",
    "@types/bun": "^1.4.3",
    "knip": "^6.41.0",
    "lefthook": "^2.2.2",
    "pkg-pr-new": "0.0.91",
    "react-doctor": "^0.9.18",
    "typescript": "7.0.2",
    "ultracite": "7.12.4"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "catalog": {
    "elysia": "2.0.0-rc.1",
    "evlog": "^2.33.1",
    "exact-mirror": "1.2.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typebox": "1.3.34"
  }
}
