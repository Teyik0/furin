{
  "name": "@teyik0/furin-root",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "bun run --filter '@teyik0/furin' build && bun run --parallel --filter '!@teyik0/furin' build",
    "cache:clean": "rm -rf node_modules examples/*/node_modules packages/*/node_modules && bun pm cache rm",
    "dev": "bun run --parallel --filter '*' --if-present dev",
    "fix": "ultracite fix",
    "iup": "bun update --interactive --recursive",
    "knip": "knip",
    "measure:client": "bun scripts/measure-client-bundle.ts",
    "performance:compare": "bun scripts/compare-performance-reports.ts",
    "performance:startup": "bun scripts/probe-server-startup.ts",
    "prepare": "lefthook install",
    "start": "bun run --parallel --filter '*' --if-present start",
    "test": "bun run --parallel --filter '*' test",
    "test:dev": "bun run --parallel --filter '*' test:dev",
    "tscheck": "bun run --parallel --filter '*' tscheck"
  },
  "overrides": {
    "brace-expansion": "^5.0.6",
    "fast-uri": "^3.1.2",
    "minimatch": "^10.2.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@happy-dom/global-registrator": "^20.14.5",
    "@types/bun": "^1.4.2",
    "knip": "^6.38.0",
    "lefthook": "^2.1.14",
    "react-doctor": "^0.9.14",
    "typescript": "^7.0.2",
    "ultracite": "7.12.1"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "catalog": {
    "elysia": "2.0.0-beta.19",
    "evlog": "^2.29.0",
    "exact-mirror": "1.2.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typebox": "1.3.34"
  }
}
