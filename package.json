{
  "name": "@teyik0/furin-root",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "bun run --filter '@teyik0/furin' build && bun run --parallel --filter '!@teyik0/furin' build",
    "cache:clean": "rm -rf node_modules examples/*/node_modules packages/*/node_modules && bun pm cache rm",
    "dev": "bun run --parallel --filter '*' --if-present dev",
    "fix": "ultracite fix",
    "iup": "bun update --interactive --recursive",
    "knip": "knip",
    "measure:client": "bun scripts/measure-client-bundle.ts",
    "prepare": "lefthook install",
    "start": "bun run --parallel --filter '*' --if-present start",
    "test": "bun run --filter '*' test",
    "test:dev": "bun run --parallel --filter '*' test:dev",
    "tscheck": "bun run --parallel --filter '*' tscheck"
  },
  "overrides": {
    "brace-expansion": "^5.0.6",
    "fast-uri": "^3.1.2",
    "minimatch": "^10.2.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@happy-dom/global-registrator": "^20.13.2",
    "@types/bun": "^1.4.0",
    "knip": "^6.34.0",
    "lefthook": "^2.1.12",
    "react-doctor": "^0.9.13",
    "typescript": "^7.0.2",
    "ultracite": "7.10.7"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "catalog": {
    "elysia": "^1.4.30",
    "evlog": "^2.28.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
