{
  "name": "@teyik0/furin-root",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "bun run --filter '@teyik0/furin' build && bun run --parallel --filter '!@teyik0/furin' build",
    "cache:clean": "rm -rf node_modules examples/*/node_modules packages/*/node_modules && bun pm cache rm",
    "dev": "bun run --parallel --filter '*' --if-present dev",
    "fix": "ultracite fix",
    "iup": "bun update --interactive --recursive",
    "knip": "knip",
    "measure:client": "bun scripts/measure-client-bundle.ts",
    "performance:compare": "bun scripts/compare-performance-reports.ts",
    "performance:startup": "bun scripts/probe-server-startup.ts",
    "prepare": "lefthook install",
    "start": "bun run --parallel --filter '*' --if-present start",
    "test": "bun run --parallel --filter '*' test",
    "test:dev": "bun run --parallel --filter '*' test:dev",
    "tscheck": "bun run --parallel --filter '*' tscheck"
  },
  "overrides": {
    "@esbuild-kit/core-utils>esbuild": "0.25.12",
    "baseline-browser-mapping": "^2.11.27",
    "brace-expansion": "^5.0.12",
    "browserslist": "^4.29.3",
    "fast-uri": "^3.1.8",
    "js-yaml": "^4.3.2",
    "minimatch": "^10.2.5",
    "mysql2": "^3.24.5",
    "postcss-selector-parser": "7.1.6",
    "smol-toml": "^1.9.0",
    "source-map-js": "^1.2.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@happy-dom/global-registrator": "^20.14.5",
    "@types/bun": "^1.4.2",
    "knip": "^6.38.0",
    "lefthook": "^2.1.14",
    "react-doctor": "^0.9.17",
    "typescript": "^7.0.2",
    "ultracite": "7.12.4"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "catalog": {
    "elysia": "2.0.0-beta.25",
    "evlog": "^2.29.0",
    "exact-mirror": "1.2.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typebox": "1.3.34"
  },
  "patchedDependencies": {
    "braces@3.0.3": "patches/braces@3.0.3.patch",
    "deepmerge-ts@7.1.5": "patches/deepmerge-ts@7.1.5.patch"
  }
}
