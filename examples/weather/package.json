{
  "name": "@teyik0/furin-example-weather",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "furin build --target bun --compile embed",
    "build:vercel": "furin build --target vercel",
    "dev": "bun --hot src/server.ts",
    "fix": "ultracite fix",
    "measure:client": "furin build --target bun --analyze && bun ../../scripts/measure-client-bundle.ts .furin/build/analysis/bun-client.json .furin/build/bun/client",
    "start": "./.furin/build/bun/server",
    "test": "bun test",
    "tscheck": "tsc --noEmit"
  },
  "dependencies": {
    "@teyik0/furin": "workspace:*",
    "@vercel/functions": "^3.9.7",
    "bun-plugin-tailwind": "^0.1.2",
    "elysia": "catalog:",
    "evlog": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "tailwindcss": "^4.3.3"
  }
}
