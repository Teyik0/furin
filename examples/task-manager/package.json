{
  "name": "@teyik0/furin-example-task-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "furin build --target bun --compile embed",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "dev": "bun --hot src/server.ts",
    "fix": "ultracite fix",
    "start": "./.furin/build/bun/server",
    "test": "bun test --parallel --isolate --bail && bun run test:e2e",
    "test:dev": "bun test --changed --parallel --isolate --bail",
    "test:e2e": "bun test --bail ./e2e/task-manager.e2e.ts",
    "tscheck": "tsc --noEmit"
  },
  "dependencies": {
    "@elysiajs/eden": "^1.4.0",
    "@teyik0/furin": "workspace:*",
    "bun-plugin-tailwind": "^0.1.2",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "elysia": "catalog:",
    "evlog": "catalog:",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.39.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-icons": "^5.6.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "drizzle-kit": "^0.31.0",
    "tailwindcss": "^4.3.3"
  }
}
