@@ -281,6 +281,20 @@ function getUtils(options, customizedDeepmerge) {
  * @param values - The values.
  */
 function mergeUnknowns(values, utils, meta) {
+    const records = values.filter((value) => getObjectType(value) === 1);
+    const active = utils.activeRecords ??= new WeakSet();
+    if (records.length > 1 && records.every((record) => active.has(record))) {
+        throw new Error("Cannot merge circular object graphs.");
+    }
+    const entered = records.filter((record) => !active.has(record));
+    for (const record of entered) active.add(record);
+    try {
+        return mergeUnknownsUnchecked(values, utils, meta);
+    } finally {
+        for (const record of entered) active.delete(record);
+    }
+}
+function mergeUnknownsUnchecked(values, utils, meta) {
     const filteredValues = utils.filterValues?.(values, meta) ?? values;
     if (filteredValues.length === 0) {
         return undefined;
