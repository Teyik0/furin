{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/react"],
  "files": {
    "includes": [
      "!!apps/docs/scripts/generate-docs-content.ts",
      "!!apps/docs/src/components/docs-pager.tsx",
      "!!apps/docs/src/components/docs-toc.tsx",
      "!!apps/docs/src/components/theme-provider.tsx",
      "!!packages/core/tests/error-boundary-navigation.test.tsx",
      "!!packages/core/tests/link/router-provider-intercept.test.tsx",
      "!!packages/core/tests/router/use-search.test.tsx",
      "!!packages/core/tests/rsc-client.test.tsx"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "javascript": {
    "globals": ["Bun"]
  },
  "formatter": {
    "enabled": true,
    "lineWidth": 100
  },
  "linter": {
    "rules": {
      "suspicious": {
        "noAssignInExpressions": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/core/src/**/*.{ts,tsx}"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "elysia/parse-query": "Import through shared/elysia-contract.ts.",
                  "elysia/schema": "Import through shared/elysia-contract.ts.",
                  "elysia/type-system": "Import through shared/elysia-contract.ts.",
                  "elysia/types": "Import through shared/elysia-contract.ts."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/core/src/shared/elysia-contract.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ]
}
