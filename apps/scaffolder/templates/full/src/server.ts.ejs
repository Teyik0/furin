import { furin } from "@teyik0/furin";
import { Elysia } from "elysia";
import { initLogger } from "evlog";
import { getHelloPayload } from "./api/hello";

initLogger({ env: { service: <%- JSON.stringify(projectNameKebab) %> } });

const app = new Elysia()
  .use(await furin({ pagesDir: "./src/pages" }))
  .get("/api/hello", () => getHelloPayload());
export const port = Number(process.env.PORT ?? 3000);

if (import.meta.main) {
  app.listen(port);
  console.log(`Furin running at http://localhost:${app.server?.port}`);
}

export default app;
