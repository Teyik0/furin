{
  "name": "@teyik0/furin-docs",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "bun run generate:content && furin build --target bun",
    "build:compiled": "bun run generate:content && furin build --target bun --compile server",
    "build:embed": "bun run generate:content && furin build --target bun --compile embed",
    "build:static": "bun run generate:content && furin build --target static",
    "dev": "bun --hot src/server.ts",
    "fix": "ultracite fix",
    "generate:content": "bun run scripts/generate-docs-content.ts && bun run scripts/generate-llms-txt.ts",
    "start": "bun run ./.furin/build/bun/server.js",
    "start:static": "bun run scripts/preview-static.ts",
    "test": "bun test --parallel --isolate --bail --preload ../../packages/core/tests/setup/global.ts",
    "test:dev": "bun test --changed --parallel --isolate --bail --preload ../../packages/core/tests/setup/global.ts",
    "tscheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@orama/orama": "^3.1.18",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.102.8",
    "@teyik0/furin": "workspace:*",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "elysia": "catalog:",
    "evlog": "catalog:",
    "hast-util-from-html": "^2.0.3",
    "hastscript": "^9.0.1",
    "lucide-react": "^1.39.0",
    "radix-ui": "^1.6.7",
    "react": "catalog:",
    "react-dom": "catalog:",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.6.0",
    "unist-util-visit-parents": "^6.0.2"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "reactDoctor": {
    "ignore": {
      "overrides": [
        {
          "files": [
            "src/pages/docs/*.tsx",
            "src/components/ui/button.tsx"
          ],
          "rules": [
            "react-doctor/only-export-components"
          ]
        }
      ]
    }
  }
}
